# Copy this file to backend/.env, replace values privately, and NEVER commit .env
# Create/view a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_PRIVATE_GEMINI_KEY_HERE
# See chrome://extensions, Developer mode ON, under your ClickShield card
CLICKSHIELD_EXTENSION_ID=PASTE_YOUR_32_CHARACTER_EXTENSION_ID_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
